# Common Mesa packages
ARG BASE_IMAGE=${BASE_IMAGE}
FROM ${BASE_IMAGE} AS mesa
RUN pacman -S --noconfirm \
  mesa \
  lib32-mesa \
  lib32-zlib-ng-compat \
  gst-plugin-va

# Intel GPU Drivers
FROM mesa AS intel-base
RUN pacman -S --noconfirm \
  vulkan-intel \
  lib32-vulkan-intel

FROM intel-base as intel-broadwell
RUN pacman -S --noconfirm \
  libva-intel-driver-irql

FROM intel-base as intel
RUN pacman -S --noconfirm \
  intel-media-driver

# oneVPL runtime for Gen12+ / Xe GPUs
FROM intel AS intel-vpl
RUN pacman -S --noconfirm \
  vpl-gpu-rt

# AMD GPU Drivers
FROM mesa AS amd
RUN pacman -S --noconfirm \
  vulkan-radeon \
  lib32-vulkan-radeon \
  xf86-video-amdgpu 

# General Mesa OpenCL support
FROM ${BASE_IMAGE} AS mesa-opencl
RUN pacman -S --noconfirm \
  opencl-mesa \
  lib32-opencl-mesa

# Iris needs RUSTICL_ENABLE to expose OpenCL; radeonsi is listed for parity
COPY rootfs/etc/profile.d/opencl.sh /etc/profile.d/
COPY rootfs/etc/environment.d/30-opencl.conf /etc/environment.d/

# Userspace Nvidia GPU Drivers
FROM ${BASE_IMAGE} AS nvidia
RUN echo "export LIBVA_DRIVER_NAME=nvidia" > /etc/profile.d/nvidia-vaapi.sh
RUN pacman -S --noconfirm \
  nvidia-utils \
  egl-wayland \
  nvidia-settings \
  opencl-nvidia \
  lib32-opencl-nvidia \
  lib32-nvidia-utils \
  libva-nvidia-driver \
  vulkan-icd-loader \
  lib32-vulkan-icd-loader \
  lib32-zlib-ng-compat \
  nvidia-open-dkms

# Include NVIDIA kernel modules in the initramfs
COPY rootfs/usr/lib/dracut/dracut.conf.d/50-nvidia.conf /usr/lib/dracut/dracut.conf.d/

# Userspace Nvidia GPU Drivers + PRIME
FROM nvidia AS nvidia-prime
RUN pacman -S --noconfirm \
  nvidia-prime \
  switcheroo-control
RUN systemctl enable switcheroo-control
RUN systemctl enable nvidia-powerd
RUN rm /etc/profile.d/nvidia-vaapi.sh

# RTD3 hybrid graphics: prefer Mesa EGL when the NVIDIA dGPU has no display outputs
COPY rootfs/etc/profile.d/nvidia-rtd3-workaround.sh /etc/profile.d/
COPY rootfs/usr/lib/systemd/user-environment-generators/20-nvidia-rtd3-workaround /usr/lib/systemd/user-environment-generators/

